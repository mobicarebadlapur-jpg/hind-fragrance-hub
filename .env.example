# Hind Fragrance Hub — environment template
# Never commit real production secrets to GitHub.

# Supabase (public/publishable values only for Vite/client usage)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-side aliases used by SSR/runtime where applicable
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional payment provider configuration (server-side only where secrets are required)
# RAZORPAY_KEY_ID=your_key_id
# RAZORPAY_KEY_SECRET=your_secret
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Optional OTP provider configuration
# OTP_PROVIDER_API_KEY=your_api_key
# OTP_PROVIDER_SENDER_ID=your_sender_id

# Optional application URL
# APP_URL=https://your-domain.example
